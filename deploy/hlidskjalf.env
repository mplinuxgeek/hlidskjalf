# /etc/hlidskjalf/hlidskjalf.env - read by hlidskjalf.service and hlidskjalf-helper.service.
# Every variable is optional; see README "Configuration".

# Listen address. 0.0.0.0 exposes the dashboard (without authentication) to
# everything that can reach the port. Prefer a LAN/management address, or
# 127.0.0.1 behind a reverse proxy that adds authentication.
#HLID_BIND=127.0.0.1
#HLID_PORT=8899

# NUT upsd for the UPS tile (unset or "none" = disabled).
#HLID_NUT_HOST=127.0.0.1
#HLID_NUT_UPS=auto

# Host switcher in the top bar (http/https URLs only).
#HLID_HOSTS=server1=http://server1.lan:8899,server2=http://server2.lan:8899

#HLID_SMART=0
#HLID_VMS=0
#HLID_GPU=0
